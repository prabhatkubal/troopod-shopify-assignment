{% comment %}Architecture decision: extend Dawn's review-app metafields instead of creating a duplicate rating data source.{% endcomment %}
{% doc %}
  Renders a product's review-app rating when both rating and count are available.

  @param {product} product - Product containing review metafields.
{% enddoc %}

{%- assign purelane_rating = product.metafields.reviews.rating.value -%}
{%- assign purelane_rating_count = product.metafields.reviews.rating_count.value -%}
{%- if purelane_rating != blank and purelane_rating_count != blank -%}
  {%- assign purelane_rating_percent = purelane_rating.rating | times: 100.0 | divided_by: purelane_rating.scale_max -%}
  <div class="purelane-rating-stars" role="img" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: purelane_rating.rating, rating_max: purelane_rating.scale_max }}">
    <span class="purelane-rating-stars__stars" aria-hidden="true" style="background: linear-gradient(90deg, var(--purelane-accent-color) 0%, var(--purelane-accent-color) {{ purelane_rating_percent }}%, rgba(var(--color-foreground), 0.2) {{ purelane_rating_percent }}%, rgba(var(--color-foreground), 0.2) 100%); -webkit-background-clip: text; background-clip: text; color: transparent;">★★★★★</span>
    <span class="purelane-rating-stars__value">{{ purelane_rating.rating }}</span>
    <span class="purelane-rating-stars__count">({{ purelane_rating_count }})</span>
  </div>
{%- endif -%}
