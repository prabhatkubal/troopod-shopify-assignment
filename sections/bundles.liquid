{% comment %}Architecture decision: Bundles uses the one shared bundle_definition model and shared bundle-card render path in a tiered grid context.{% endcomment %}
<section class="purelane-bundles color-{{ section.settings.color_scheme }} gradient" style="--purelane-bundles-padding-top: {{ section.settings.padding_top }}px; --purelane-bundles-padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="purelane-bundles__inner page-width">
    {% render 'purelane-section-heading', heading: section.settings.heading, eyebrow: section.settings.eyebrow, description: section.settings.description, alignment: section.settings.content_alignment, heading_tag: 'h2' %}
    <div class="purelane-bundles__tiers" role="list">
      {%- for block in section.blocks -%}
        {%- if block.settings.bundle_definition != blank -%}
          <div class="purelane-bundles__tier" role="listitem" {{ block.shopify_attributes }}>
            {% render 'purelane-bundle-card', bundle_definition: block.settings.bundle_definition, variant: 'tier' %}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .purelane-bundles { padding-top: var(--purelane-bundles-padding-top); padding-bottom: var(--purelane-bundles-padding-bottom); }
  .purelane-bundles__tiers { display: grid; gap: var(--purelane-space-4); margin-top: var(--purelane-space-8); }
  .purelane-bundles__tier { min-width: 0; }
  @media screen and (min-width: 750px) { .purelane-bundles__tiers { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media screen and (min-width: 990px) { .purelane-bundles__tiers { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--purelane-space-6); } }
{% endstylesheet %}

{% schema %}
{
  "name": "Purelane bundles", "tag": "section", "class": "section",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "One box. Every room." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Build your bundle" },
    { "type": "richtext", "id": "description", "label": "Description" },
    { "type": "select", "id": "content_alignment", "label": "Heading alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 36 }
  ],
  "blocks": [{ "type": "bundle_tier", "name": "Bundle tier", "settings": [{ "type": "metaobject", "id": "bundle_definition", "label": "Bundle definition", "metaobject_type": "bundle_definition" }] }],
  "presets": [{ "name": "Purelane bundles" }]
}
{% endschema %}
